# Copy this file to .env for local use, or paste these into Vercel's
# Environment Variables screen. Never commit the real .env.

# --- Required ---
# Any long random text. Sign-in cookies and codes are signed with it, so
# changing it signs everyone out. On Vercel the app refuses to start without it.
SECRET_KEY=

# --- Database ---
# Leave DATABASE_URL empty on your laptop and the app uses a SQLite file.
# On Vercel you need Postgres (Neon), because Vercel does not keep files.
DATABASE_URL=
# Where the SQLite file lives locally. Default: fomo.db next to app.py.
# DB_PATH=

# --- Who can sign in ---
# Only emails ending in this domain are accepted.
ALLOWED_DOMAIN=flame.edu.in
# Comma-separated. These accounts get the "Add event" tab.
ADMIN_EMAILS=

# --- Sending the 6-digit codes ---
# Without SMTP_HOST the app cannot email codes. See the README.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Testing only ---
# 1 shows the sign-in code on screen instead of emailing it.
# REMOVE THIS before real students use the app: with it on, anyone can sign in
# as anyone.
DEV_SHOW_CODE=

# --- Optional: Continue with Google ---
GOOGLE_CLIENT_ID=

# --- Local only ---
# Port for `python app.py`. Default 5000.
# PORT=5000
